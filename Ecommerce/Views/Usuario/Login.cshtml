@using Ecommerce.DTO
@using Ecommerce.ViewModels

@model LoginViewModel
@{
    var categorias = ViewBag.CategoriasMaisVendidas as List<DTOCategoriaMaisVendida>;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-page">
    <section class="login-card">

        <!-- Lado esquerdo: apresentação -->
        <div class="login-hero">
            <div class="login-hero__content">
                <span class="eyebrow">Bem-vindo à Nexo</span>
                <h1 class="login-hero__title">
                    O melhor daqui <br />
                    fica ainda melhor <br />
                    <span class="highlight">com você.</span>
                </h1>
                <p class="login-hero__text">
                    Entre para salvar suas descobertas, acompanhar seus
                    pedidos e aproveitar cada oportunidade.
                </p>
            </div>

            <div class="login-hero__footer">
                <span class="login-hero__line"></span>
                <span class="login-hero__slogan">Escolhas que conectam.</span>
            </div>
        </div>

        <!-- Lado direito: formulário -->
        <div class="login-form-wrap">
            <span class="eyebrow">Sua conta Nexo</span>
            <h2 class="login-form__title">Bom ter você de volta.</h2>
            <p class="login-form__subtitle">Acesse sua conta para continuar de onde parou.</p>

            <div class="tabs" role="tablist">
                <span class="tab is-active" role="tab" aria-selected="true">Entrar</span>
                <a class="tab" asp-controller="Usuario" asp-action="Cadastro">Criar conta</a>
            </div>

            <form class="login-form" asp-controller="Usuario" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div class="field">
                    <label asp-for="Email">E-mail ou Apelido</label>
                    <input asp-for="Email" placeholder="Digite seu e-mail ou apelido" autocomplete="username" />
                    <span asp-validation-for="Email" class="login-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" type="password" placeholder="Mínimo de 6 caracteres" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="login-error"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="login-error"></div>

                <button type="submit" class="login-btn">
                    <span>Entrar</span>
                </button>
            </form>

            <p class="login-signup">
                Ainda não tem conta?
                <a asp-controller="Usuario" asp-action="Cadastro" asp-route-returnUrl="@ViewData["ReturnUrl"]">Criar conta</a>
            </p>
        </div>
    </section>
</div>
