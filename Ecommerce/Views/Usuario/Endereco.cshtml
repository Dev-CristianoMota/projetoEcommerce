
@model List<Ecommerce.DTO.DTOEndereco>

@{
    var limiteAtingido = Model != null
        && Model.Count >= Ecommerce.Services.EnderecoService.MaxEnderecos;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/endereco.css" asp-append-version="true" />
}

<nav class="navigation">

    <div class="navigation-content">

        <div class="nav-left">

            <a href="#" class="nav-item all-products">

                <span class="material-symbols-outlined">
                    view_comfy_alt
                </span>

                Todos os produtos

            </a>


            <div class="nav-divider"></div>

            <a href="#" class="nav-item">
                Celulares e Telefones
            </a>

            <a href="#" class="nav-item">
                Moda e Acessórios
            </a>

            <a href="#" class="nav-item">
                Eletrodomésticos
            </a>

            <a href="#" class="nav-item">
                Casa e Decoração
            </a>

            <a href="#" class="nav-item">
                Veículos e Peças
            </a>

            <a href="#" class="nav-item">
                Alimentos
            </a>

        </div>


        <a href="#" class="special-offers">

            Ofertas especiais

            <span class="material-symbols-outlined">
                arrow_forward
            </span>

        </a>

    </div>

</nav>

<main class="principal">
    <nav class="breadcrumb">
        <a href="/">
            Início
        </a>
        <span>/</span>
        <a asp-controller="Usuario" asp-action="Conta">Minha Conta</a>
        <span>/</span>
        <span>
            Enderecos
        </span>
    </nav>

    <section class="addresses">
        <div class="addresses-header">
            <div class="addresses-heading">
                <div class="addresses-heading-icon">
                    <span class="material-symbols-outlined">
                        location_on
                    </span>
                </div>

                <div>
                    <h2>Meus endereços</h2>
                    <p>Gerencie seus endereços de entrega.</p>
                </div>
            </div>
            <button type="button"
                    class="address-add-button js-novo-endereco"
                    disabled="@limiteAtingido"
                    title="@(limiteAtingido ? "Limite de endereços atingido" : "")">
                <span class="material-symbols-outlined">add</span>
                Novo endereço
            </button>
        </div>
        @if (limiteAtingido)
        {
            <p class="addresses-limit-notice">
                <span class="material-symbols-outlined">info</span>
                Você atingiu o limite de @Ecommerce.Services.EnderecoService.MaxEnderecos endereços.
                Exclua um endereço para cadastrar outro ou edite um ja existente.
            </p>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="addresses-empty">
                <div class="addresses-empty-icon">
                    <span class="material-symbols-outlined">
                        location_off
                    </span>
                </div>

                <h3>Nenhum endereço cadastrado</h3>

                <p>
                    Você ainda não possui endereços salvos.
                    Cadastre um endereço para facilitar suas próximas compras.
                </p>

                <button type="button" class="address-empty-button js-novo-endereco">
                    Cadastrar endereço
                </button>
            </div>
        }
        else
        {
            var enderecoPrincipal = Model
                .FirstOrDefault(e => e.IcEnderecoPrincipal);

            var enderecosSecundarios = Model
                .Where(e => !e.IcEnderecoPrincipal)
                .ToList();

            <div class="addresses-count">
                <span>
                    @Model.Count @(Model.Count == 1 ? "endereço cadastrado" : "endereços cadastrados")
                </span>
            </div>

            @if (enderecoPrincipal != null)
            {
                <div class="addresses-group">
                    <div class="addresses-group-header">
                        <span class="material-symbols-outlined">
                            verified
                        </span>
                        <h3>Endereço principal</h3>
                    </div>

                    <article class="address-card address-card-primary">
                        <div class="address-card-top">
                            <div class="address-card-identification">
                                <div class="address-card-icon">
                                    <span class="material-symbols-outlined">
                                        home
                                    </span>
                                </div>

                                <div>
                                    <h4>@enderecoPrincipal.NmIdentificacao</h4>
                                    <span class="address-recipient">
                                        @enderecoPrincipal.NmDestinatario
                                    </span>
                                </div>
                            </div>

                            <span class="address-primary-badge">
                                <span class="material-symbols-outlined">
                                    check_circle
                                </span>
                                Principal
                            </span>
                        </div>

                        <div class="address-card-body">
                            <p>
                                @enderecoPrincipal.Logradouro,
                                @enderecoPrincipal.Numero
                            </p>

                            @if (!string.IsNullOrWhiteSpace(
                                enderecoPrincipal.DsComplemento))
                            {
                                <p>@enderecoPrincipal.DsComplemento</p>
                            }

                            <p>
                                @enderecoPrincipal.Bairro
                                <span class="address-separator">·</span>
                                @enderecoPrincipal.Cidade -
                                @enderecoPrincipal.UF
                            </p>

                            <p class="address-cep">
                                CEP: @enderecoPrincipal.CEP
                            </p>
                        </div>

                        <div class="address-card-footer">
                            <button type="button"
                                    class="address-action address-edit"
                                    data-cd-endereco="@enderecoPrincipal.CdEndereco"
                                    data-identificacao="@enderecoPrincipal.NmIdentificacao"
                                    data-destinatario="@enderecoPrincipal.NmDestinatario"
                                    data-cep="@enderecoPrincipal.CEP"
                                    data-logradouro="@enderecoPrincipal.Logradouro"
                                    data-numero="@enderecoPrincipal.Numero"
                                    data-complemento="@enderecoPrincipal.DsComplemento"
                                    data-bairro="@enderecoPrincipal.Bairro"
                                    data-cidade="@enderecoPrincipal.Cidade"
                                    data-uf="@enderecoPrincipal.UF">
                                <span class="material-symbols-outlined">edit</span>
                                Editar
                            </button>
                            <button type="button"
                                    class="address-action address-delete"
                                    data-cd-endereco="@enderecoPrincipal.CdEndereco"
                                    data-principal="true">
                                <span class="material-symbols-outlined">delete</span>
                                Excluir
                            </button>
                        </div>
                    </article>
                </div>
            }

            @if (enderecosSecundarios.Any())
            {
                <div class="addresses-group addresses-secondary-group">
                    <div class="addresses-group-header">
                        <span class="material-symbols-outlined">
                            location_on
                        </span>
                        <h3>Endereços secundários</h3>
                    </div>

                    <div class="addresses-grid">
                        @foreach (var endereco in enderecosSecundarios)
                        {
                            <article class="address-card">
                                <div class="address-card-top">
                                    <div class="address-card-identification">
                                        <div class="address-card-icon">
                                            <span class="material-symbols-outlined">
                                                location_on
                                            </span>
                                        </div>

                                        <div>
                                            <h4>@endereco.NmIdentificacao</h4>
                                            <span class="address-recipient">
                                                @endereco.NmDestinatario
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="address-card-body">
                                    <p>
                                        @endereco.Logradouro,
                                        @endereco.Numero
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(
                                        endereco.DsComplemento))
                                    {
                                        <p>@endereco.DsComplemento</p>
                                    }

                                    <p>
                                        @endereco.Bairro
                                        <span class="address-separator">·</span>
                                        @endereco.Cidade -
                                        @endereco.UF
                                    </p>

                                    <p class="address-cep">
                                        CEP: @endereco.CEP
                                    </p>
                                </div>

                                <div class="address-card-footer">
                                    <button type="button"
                                            class="address-action address-edit"
                                            data-cd-endereco="@endereco.CdEndereco"
                                            data-identificacao="@endereco.NmIdentificacao"
                                            data-destinatario="@endereco.NmDestinatario"
                                            data-cep="@endereco.CEP"
                                            data-logradouro="@endereco.Logradouro"
                                            data-numero="@endereco.Numero"
                                            data-complemento="@endereco.DsComplemento"
                                            data-bairro="@endereco.Bairro"
                                            data-cidade="@endereco.Cidade"
                                            data-uf="@endereco.UF">
                                        <span class="material-symbols-outlined">edit</span>
                                        Editar
                                    </button>

                                    <button type="button"
                                            class="address-action address-set-primary"
                                            data-cd-endereco="@endereco.CdEndereco">
                                        <span class="material-symbols-outlined">push_pin</span>
                                        Tornar principal
                                    </button>

                                    <button type="button"
                                            class="address-action address-delete"
                                            data-cd-endereco="@endereco.CdEndereco"
                                            data-principal="false">
                                        <span class="material-symbols-outlined">delete</span>
                                        Excluir
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        }
    </section>
</main>

@Html.AntiForgeryToken()

<dialog id="dialogPrincipal" class="confirm-dialog" data-url="@Url.Action("TornarEnderecoPrincipal", "Endereco")">
    <div class="confirm-dialog-content">
        <div class="confirm-dialog-icon">
            <span class="material-symbols-outlined">push_pin</span>
        </div>

        <h3 class="confirm-dialog-title">Tornar endereço principal?</h3>
        <p class="confirm-dialog-text">
            Este endereço passará a ser o padrão nas suas compras.
            O endereço principal atual se tornará secundário.
        </p>

        <p id="dialogErro" class="confirm-dialog-error" hidden></p>

        <div class="confirm-dialog-actions">
            <button type="button" id="btnNao"
                    class="confirm-dialog-btn confirm-dialog-btn-secondary">
                Não tornar
            </button>
            <button type="button" id="btnSim"
                    class="confirm-dialog-btn confirm-dialog-btn-primary">
                Sim, tornar principal
            </button>
        </div>
    </div>
</dialog>

<dialog id="dialogEditar"
        class="confirm-dialog edit-dialog"
        data-url="@Url.Action("EditarEndereco", "Endereco")">
    <form id="formEditar" class="confirm-dialog-content" novalidate>
        <div class="confirm-dialog-icon">
            <span class="material-symbols-outlined">edit_location</span>
        </div>
        <h3 class="confirm-dialog-title">Editar endereço</h3>

        <input type="hidden" name="CdEndereco" />

        <div class="edit-form-grid">
            <label class="edit-field edit-field-full">
                Identificação
                <input type="text" name="NmIdentificacao" maxlength="50" placeholder="Casa, Trabalho..." required />
            </label>

            <label class="edit-field edit-field-full">
                Destinatário
                <input type="text" name="NmDestinatario" maxlength="100" required />
            </label>

            <label class="edit-field">
                CEP
                <input type="text" name="CEP" maxlength="9" inputmode="numeric" placeholder="00000-000" required />
            </label>

            <label class="edit-field">
                UF
                <input type="text" name="UF" maxlength="2" style="text-transform:uppercase" required />
            </label>

            <label class="edit-field edit-field-full">
                Logradouro
                <input type="text" name="Logradouro" maxlength="150" required />
            </label>

            <label class="edit-field">
                Número
                <input type="text" name="Numero" maxlength="10" required />
            </label>

            <label class="edit-field">
                Complemento
                <input type="text" name="DsComplemento" maxlength="100" />
            </label>

            <label class="edit-field">
                Bairro
                <input type="text" name="Bairro" maxlength="100" required />
            </label>

            <label class="edit-field">
                Cidade
                <input type="text" name="Cidade" maxlength="100" required />
            </label>
        </div>

        <p id="dialogEditarErro" class="confirm-dialog-error" hidden></p>

        <div class="confirm-dialog-actions">
            <button type="button" id="btnEditarCancelar"
                    class="confirm-dialog-btn confirm-dialog-btn-secondary">
                Cancelar
            </button>
            <button type="submit" id="btnEditarSalvar"
                    class="confirm-dialog-btn confirm-dialog-btn-primary">
                Salvar alterações
            </button>
        </div>
    </form>
</dialog>

<dialog id="dialogExcluir"
        class="confirm-dialog"
        data-url="@Url.Action("ExcluirEndereco", "Endereco")">
    <div class="confirm-dialog-content">
        <div class="confirm-dialog-icon confirm-dialog-icon-danger">
            <span class="material-symbols-outlined">delete</span>
        </div>

        <h3 class="confirm-dialog-title">Excluir endereço?</h3>
        <p class="confirm-dialog-text">
            Esta ação não pode ser desfeita.
        </p>
        <p id="dialogExcluirAviso" class="confirm-dialog-text confirm-dialog-warning" hidden>
            Este é o seu endereço principal. Outro endereço será definido
            como principal automaticamente.
        </p>

        <p id="dialogExcluirErro" class="confirm-dialog-error" hidden></p>

        <div class="confirm-dialog-actions">
            <button type="button" id="btnExcluirNao"
                    class="confirm-dialog-btn confirm-dialog-btn-secondary">
                Cancelar
            </button>
            <button type="button" id="btnExcluirSim"
                    class="confirm-dialog-btn confirm-dialog-btn-danger">
                Sim, excluir
            </button>
        </div>
    </div>
</dialog>

<dialog id="dialogCadastrar"
        class="confirm-dialog edit-dialog"
        data-url="@Url.Action("CadastrarEndereco", "Endereco")">
    <form id="formCadastrar" class="confirm-dialog-content" novalidate>
        <div class="confirm-dialog-icon">
            <span class="material-symbols-outlined">add_location_alt</span>
        </div>
        <h3 class="confirm-dialog-title">Novo endereço</h3>

        <div class="cep-search">
            <label class="edit-field">
                CEP
                <input type="text" name="CEP" inputmode="numeric" maxlength="9"
                       placeholder="00000-000" autocomplete="postal-code"
                       pattern="\d{5}-?\d{3}" required />
            </label>
            <button type="button" id="btnBuscarCep"
                    class="confirm-dialog-btn confirm-dialog-btn-secondary" disabled>
                Buscar
            </button>
        </div>
        <p id="cepStatus" class="cep-status" hidden></p>

        <fieldset id="camposEndereco" class="cad-fields" disabled>
            <div class="edit-form-grid">
                <label class="edit-field edit-field-full">
                    Identificação
                    <input type="text" name="NmIdentificacao" maxlength="50" placeholder="Casa, Trabalho..." required />
                </label>

                <label class="edit-field edit-field-full">
                    Destinatário
                    <input type="text" name="NmDestinatario" maxlength="100" required />
                </label>

                <label class="edit-field edit-field-full">
                    Logradouro
                    <input type="text" name="Logradouro" maxlength="150" required />
                </label>

                <label class="edit-field">
                    Número
                    <input type="text" name="Numero" maxlength="10" required />
                </label>

                <label class="edit-field">
                    Complemento
                    <input type="text" name="DsComplemento" maxlength="100" />
                </label>

                <label class="edit-field">
                    Bairro
                    <input type="text" name="Bairro" maxlength="100" required />
                </label>

                <label class="edit-field">
                    Cidade
                    <input type="text" name="Cidade" maxlength="100" required />
                </label>

                <label class="edit-field">
                    UF
                    <input type="text" name="UF" maxlength="2" style="text-transform:uppercase" required />
                </label>
            </div>
        </fieldset>

        <p id="dialogCadastrarErro" class="confirm-dialog-error" hidden></p>

        <div class="confirm-dialog-actions">
            <button type="button" id="btnCadastrarCancelar"
                    class="confirm-dialog-btn confirm-dialog-btn-secondary">
                Cancelar
            </button>
            <button type="submit" id="btnCadastrarSalvar"
                    class="confirm-dialog-btn confirm-dialog-btn-primary" disabled>
                Cadastrar endereço
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/endereco.js" asp-append-version="true"></script>
}