@model Ecommerce.Models.Usuario
@using Ecommerce.DTO
@{
    ViewData["Title"] = "Ecommerce";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
}

<nav class="navigation">

<div class="navigation-content">

    <div class="nav-left">

        <a href="#" class="nav-item all-products">

            <span class="material-symbols-outlined">
                view_comfy_alt
            </span>

            Todos os produtos

        </a>


        <div class="nav-divider"></div>

        <a href="#" class="nav-item">
            Celulares e Telefones        
        </a>

        <a href="#" class="nav-item">
            Moda e Acessórios
        </a>

        <a href="#" class="nav-item">
            Eletrodomésticos
        </a>

        <a href="#" class="nav-item">
            Casa e Decoração
        </a>

        <a href="#" class="nav-item">
            Veículos e Peças
        </a>

        <a href="#" class="nav-item">
            Alimentos
        </a>

    </div>


    <a href="#" class="special-offers">

        Ofertas especiais

        <span class="material-symbols-outlined">
            arrow_forward
        </span>

    </a>

</div>

</nav>

<main class="profile">
    <nav class="breadcrumb">
        <a href="#">
            Início
        </a>
        <span>/</span>
        <span>
            Central Minha Conta
        </span>
    </nav>
    
    <section class="profile-intro">
    <div class="profile-intro-content">
        <div class="profile-intro-info">
            <span class="profile-label">
                CENTRAL DO CLIENTE
            </span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1>
                    Olá, <span>@User.Identity.Name</span>!
                </h1>

                <p class="profile-email">
                    <span class="material-symbols-outlined">
                        mail
                    </span>
                    @Model.NmEmail
                </p>
            }
            else
            {
                <h1>
                    Bem-vindo à sua conta!
                </h1>

                <p class="profile-email">
                    Acesse sua conta para gerenciar seus dados.
                </p>
            }
        </div>

            <a asp-controller="Usuario"
                asp-action="Editar"
                class="profile-edit-btn">
                <span>EDITAR DADOS</span>
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>
    </section>

    <section class="atalhos">
        <div class="header-atalhos">
            <div class="atalhos-heading-icon">
                <span class="material-symbols-outlined">
                    apps
                </span>
            </div>

            <div>
                <h2 class="atalhos-titulo">
                    Acesso rápido
                </h2>

                <p class="atalhos-subtitulo">
                    Encontre facilmente o que você precisa.
                </p>
            </div>
        </div>

        <div class="atalhos-grid">
            <a asp-controller="Pedido"
               asp-action="Index"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    shopping_bag
                </span>
                <span class="atalho-texto">Meus pedidos</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Usuario"
               asp-action="Editar"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    person
                </span>
                <span class="atalho-texto">Meus dados</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Usuario"
               asp-action="Endereco"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    location_on
                </span>
                <span class="atalho-texto">Endereços</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Carteira"
               asp-action="Index"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    wallet
                </span>
                <span class="atalho-texto">Carteira</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Favorito"
               asp-action="Index"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    support_agent
                </span>
                <span class="atalho-texto">Atendimento ao cliente</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <form asp-controller="Usuario" asp-action="Logout" method="post" style="display: contents;">
                <button type="submit" class="atalho atalho-botao">
                    <span class="atalho-icon material-symbols-outlined">
                        logout
                    </span>
                    <span class="atalho-texto">Sair</span>
                    <span class="atalho-arrow material-symbols-outlined">
                        arrow_forward
                    </span>
                </button>
            </form>
        </div>
    </section>
    <section class="last-order">
        <div class="last-order-header">
            <div class="last-order-heading">
                <div class="last-order-icon">
                    <span class="material-symbols-outlined">
                        receipt_long
                    </span>
                </div>

                <div>
                    <h2>Último pedido</h2>
                    <p>Confira os detalhes da sua compra mais recente.</p>
                </div>
            </div>

            <a asp-controller="Pedido"
               asp-action="Index"
               class="last-order-all">
                Ver todos
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="last-order-content">

            <div class="last-order-info">
                <div class="last-order-number">
                    <span class="last-order-label">NÚMERO DO PEDIDO</span>
                    <strong>#000184</strong>
                    <span class="last-order-date">
                        Realizado em 08/10/2026 às 14:35
                    </span>
                </div>

                <span class="last-order-status status-transit">
                    <span class="status-dot"></span>
                    Em transporte
                </span>
            </div>

            <div class="last-order-store">
                <span class="material-symbols-outlined">
                    storefront
                </span>

                <div>
                    <span>Vendido por</span>
                    <strong>Tech Store</strong>
                </div>
            </div>

            <div class="last-order-section-title">
                <h3>Produtos do pedido</h3>
                <span>3 itens</span>
            </div>

            <div class="last-order-products">

                <div class="last-order-product">
                    <div class="product-placeholder">
                        <span class="material-symbols-outlined">
                            headphones
                        </span>
                    </div>

                    <div class="product-info">
                        <strong>Fone Bluetooth Premium</strong>
                        <span>Quantidade: 1 unidade</span>
                    </div>

                    <div class="product-values">
                        <span>Valor unitário</span>
                        <strong>R$ 299,90</strong>
                    </div>
                </div>

                <div class="last-order-product">
                    <div class="product-placeholder">
                        <span class="material-symbols-outlined">
                            watch
                        </span>
                    </div>

                    <div class="product-info">
                        <strong>Smartwatch Esportivo</strong>
                        <span>Quantidade: 1 unidade</span>
                    </div>

                    <div class="product-values">
                        <span>Valor unitário</span>
                        <strong>R$ 249,90</strong>
                    </div>
                </div>

                <div class="last-order-product">
                    <div class="product-placeholder">
                        <span class="material-symbols-outlined">
                            cable
                        </span>
                    </div>

                    <div class="product-info">
                        <strong>Cabo USB-C Reforçado</strong>
                        <span>Quantidade: 1 unidade</span>
                    </div>

                    <div class="product-values">
                        <span>Valor unitário</span>
                        <strong>R$ 50,00</strong>
                    </div>
                </div>

            </div>

            <div class="last-order-delivery">
                <div class="delivery-heading">
                    <span class="material-symbols-outlined">
                        location_on
                    </span>

                    <div>
                        <h3>Endereço de entrega</h3>
                        <p>Casa</p>
                    </div>
                </div>

                <div class="delivery-address">
                    <strong>Marina Costa</strong>
                    <span>Rua das Flores, 125</span>
                    <span>Apto. 42 — Centro</span>
                    <span>Santos - SP, CEP 11000-000</span>
                </div>
            </div>

            <div class="last-order-summary">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong>R$ 599,80</strong>
                </div>

                <div class="summary-row">
                    <span>Cupom de desconto (BEMVINDO10)</span>
                    <strong class="summary-discount">− R$ 0,00</strong>
                </div>

                <div class="summary-row summary-total">
                    <span>Total do pedido</span>
                    <strong>R$ 599,80</strong>
                </div>
            </div>

            <div class="last-order-footer">
                <div class="last-order-payment-info">
                    <span class="material-symbols-outlined">
                        info
                    </span>

                    <p>
                        Acompanhe o status e os detalhes completos do seu pedido.
                    </p>
                </div>

                <a asp-controller="Pedido"
                   asp-action="Detalhes"
                   asp-route-id="184"
                   class="last-order-button">
                    Ver detalhes
                    <span class="material-symbols-outlined">
                        arrow_forward
                    </span>
                </a>
            </div>

        </div>
    </section>
</main>