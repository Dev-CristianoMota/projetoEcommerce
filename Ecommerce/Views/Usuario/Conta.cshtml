@using System.Globalization
@using System.Security.Claims
@using Ecommerce.ViewModels
@inject Ecommerce.Services.PedidoService PedidoService
@{
    ViewData["Title"] = "Minha Conta";
    var pt = CultureInfo.GetCultureInfo("pt-BR");

    UltimoPedidoContaViewModel? pedido = null;

    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var cdUsuario))
        pedido = await PedidoService.BuscarUltimoPedidoAsync(cdUsuario);
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
}

<partial name="_NavegacaoCategorias" />

<main class="profile">
    <nav class="breadcrumb">
        <a href="/">
            Início
        </a>
        <span>/</span>
        <span>
            Minha Conta
        </span>
    </nav>
    
    <section class="profile-intro">
    <div class="profile-intro-content">
        <div class="profile-intro-info">
            <span class="profile-label">
                CENTRAL DO CLIENTE
            </span>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1>
                    Olá, <span>@User.Identity.Name</span>!
                </h1>

                <p class="profile-email">
                    <span class="material-symbols-outlined">
                        mail
                    </span>
                        @User.FindFirstValue(ClaimTypes.Email)
                </p>
            }
            else
            {
                <h1>
                    Bem-vindo à sua conta!
                </h1>

                <p class="profile-email">
                    Acesse sua conta para gerenciar seus dados.
                </p>
            }
        </div>

            <a asp-controller="Usuario"
                asp-action="MeusDados"
                class="profile-edit-btn">
                <span>EDITAR DADOS</span>
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>
    </section>

    <section class="atalhos">
        <div class="header-atalhos">
            <div class="atalhos-heading-icon">
                <span class="material-symbols-outlined">
                    apps
                </span>
            </div>

            <div>
                <h2 class="atalhos-titulo">
                    Acesso rápido
                </h2>

                <p class="atalhos-subtitulo">
                    Encontre facilmente o que você precisa.
                </p>
            </div>
        </div>

        <div class="atalhos-grid">
            <a asp-controller="Pedido"
                asp-action="ListarPedidosUsuario"
                class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    shopping_bag
                </span>
                <span class="atalho-texto">Meus pedidos</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Usuario"
               asp-action="MeusDados"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    person
                </span>
                <span class="atalho-texto">Meus dados</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Endereco"
               asp-action="Endereco"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    location_on
                </span>
                <span class="atalho-texto">Endereços</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Carteira"
               asp-action="Index"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    wallet
                </span>
                <span class="atalho-texto">Carteira</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <a asp-controller="Favorito"
               asp-action="Index"
               class="atalho">
                <span class="atalho-icon material-symbols-outlined">
                    support_agent
                </span>
                <span class="atalho-texto">Atendimento ao cliente</span>
                <span class="atalho-arrow material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

            <form asp-controller="Usuario" asp-action="Logout" method="post" style="display: contents;">
                <button type="submit" class="atalho atalho-botao">
                    <span class="atalho-icon material-symbols-outlined">
                        logout
                    </span>
                    <span class="atalho-texto">Sair</span>
                    <span class="atalho-arrow material-symbols-outlined">
                        arrow_forward
                    </span>
                </button>
            </form>
        </div>
    </section>
    
    <section class="last-order">
        <div class="last-order-header">
            <div class="last-order-heading">
                <div class="last-order-icon">
                    <span class="material-symbols-outlined">shopping_cart</span>
                </div>
                <h2>Resumo do seu último pedido</h2>
            </div>

            <a asp-controller="Pedido" asp-action="ListarPedidosUsuario" class="last-order-all">
                Ir para meus pedidos
            </a>
        </div>

        @if (pedido == null)
        {
            <div class="last-order-empty">
                <p>Você ainda não fez nenhum pedido.</p>
                <a asp-controller="FeedProduto" asp-action="Index">Explorar produtos</a>
            </div>
        }
        else
        {
            <div class="last-order-content">
                <div class="last-order-info">
                    <div class="last-order-number">
                        <span><strong>Pedido:</strong> @pedido.NumeroFormatado – @pedido.DtCriacao.ToString("dd/MM/yyyy")</span>
                    </div>

                    <a asp-controller="Pedido" asp-action="Detalhes" asp-route-id="@pedido.CdPedido" class="last-order-button">
                        Ver detalhes
                        <span class="material-symbols-outlined">chevron_right</span>
                    </a>
                </div>

                <span class="last-order-status @pedido.StatusCss">
                    <span class="status-dot"></span>@pedido.StatusTexto
                </span>

                <div class="last-order-store">
                    <span class="material-symbols-outlined">storefront</span>
                    <div><span>Vendido por</span> <strong>@pedido.NmLoja</strong></div>
                </div>

                <div class="last-order-products">
                    @foreach (var item in pedido.Itens)
                    {
                        <div class="last-order-product">
                            <div class="product-placeholder">
                                <span class="material-symbols-outlined">inventory_2</span>
                            </div>

                            <div class="product-info">
                                <strong>@item.NmProduto</strong>
                                <span>Quantidade: @item.Quantidade</span>
                            </div>

                            <div class="product-values">
                                <strong>@item.VlUnitario.ToString("C", pt)</strong>
                            </div>
                        </div>
                    }
                </div>

                <div class="last-order-summary">
                    <div class="summary-row summary-total">
                        <span>Total do pedido (@pedido.QtTotalItens @(pedido.QtTotalItens == 1 ? "item" : "itens"))</span>
                        <strong>@pedido.VlTotal.ToString("C", pt)</strong>
                    </div>
                </div>
            </div>
        }
    </section>
</main>