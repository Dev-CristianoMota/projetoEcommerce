@using Ecommerce.ViewModels
@model FeedProdutosViewModel
@{
    ViewData["Title"] = "Todos os produtos";

    var ordens = new[]
    {
        ("recentes",      "Mais recentes"),
        ("antigos",       "Mais antigos"),
        ("mais-vendidos", "Mais vendidos"),
        ("menor-preco",   "Menor preço"),
        ("maior-preco",   "Maior preço"),
        ("nome",          "Nome (A–Z)")
    };
}

@section Styles {
    @* Os cards (.product-card, .badge, .favorite...) vêm do mesmo CSS da Home. Ajuste o nome se for diferente. *@
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
}

<partial name="_NavegacaoCategorias" />

<main class="main-content feed-page">

    <div class="section-header">
        <div>
            <span class="eyebrow">CATÁLOGO COMPLETO</span>
            <h2>Todos os produtos</h2>
            <p>Explore tudo o que a plataforma tem a oferecer.</p>
        </div>

        <div class="feed-toolbar">
            <span class="feed-count">
                <strong id="feedTotal">@Model.Total.ToString("N0", new System.Globalization.CultureInfo("pt-BR"))</strong>
                <span id="feedTotalTexto">@(Model.Total == 1 ? "produto" : "produtos")</span>
            </span>

            <label class="feed-sort">
                <span>Ordenar:</span>
                <select name="Ordem" form="feedForm" id="feedOrdem">
                    @foreach (var (valor, texto) in ordens)
                    {
                        <option value="@valor" selected="@(Model.Filtro.Ordem == valor)">@texto</option>
                    }
                </select>
            </label>

            <button type="button" class="feed-filter-toggle" id="btnFiltros" aria-expanded="false" aria-controls="feedFilters">
                <span class="material-symbols-outlined">tune</span>
                Filtros
            </button>
        </div>
    </div>

    <div class="feed-layout">

        <!-- ===== Filtros ===== -->
        <aside class="feed-filters" id="feedFilters" aria-label="Filtros">
            <form id="feedForm" method="get" asp-controller="Feed" asp-action="Index">

                <div class="filter-box">
                    <h3 class="filter-title">Preço</h3>
                    <div class="price-range">
                        <label>
                            <span>Mínimo</span>
                            <input type="number" name="PrecoMin" min="0" step="1" inputmode="numeric"
                                   placeholder="R$ 0" value="@Model.Filtro.PrecoMin" />
                        </label>
                        <span class="price-sep">–</span>
                        <label>
                            <span>Máximo</span>
                            <input type="number" name="PrecoMax" min="0" step="1" inputmode="numeric"
                                   placeholder="R$ 0" value="@Model.Filtro.PrecoMax" />
                        </label>
                    </div>
                </div>

                <div class="filter-box">
                    <h3 class="filter-title">Categorias</h3>
                    <div class="filter-list">
                        @foreach (var c in Model.Categorias)
                        {
                            <label class="filter-check">
                                <input type="checkbox" name="Categorias" value="@c.CdCategoria"
                                       @(Model.Filtro.Categorias.Contains(c.CdCategoria) ? "checked" : null) />
                                <span class="filter-check__text">@c.NmCategoria</span>
                                <span class="filter-count">@c.QtProdutos</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="filter-box">
                    <h3 class="filter-title">Disponibilidade</h3>
                    <div class="filter-list">
                        <label class="filter-check">
                            <input type="checkbox" name="ApenasEstoque" value="true"
                                   @(Model.Filtro.ApenasEstoque ? "checked" : null) />
                            <span class="filter-check__text">Somente em estoque</span>
                        </label>
                    </div>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="filter-apply">Aplicar filtros</button>
                    <a asp-controller="Feed" asp-action="Index" class="filter-clear" id="feedLimpar">Limpar filtros</a>
                </div>
            </form>
        </aside>

        <!-- ===== Feed ===== -->
        <section class="feed-results" aria-live="polite">

            <div class="products-grid" id="feedGrid">
                <partial name="_ProdutoCards" model="Model.Produtos" />
            </div>

            <div class="feed-empty" id="feedVazio" @(Model.Produtos.Count > 0 ? "hidden" : null)>
                <span class="material-symbols-outlined">search_off</span>
                <h3>Nenhum produto encontrado</h3>
                <p>Tente ajustar ou remover alguns filtros.</p>
            </div>

            <div class="feed-loader" id="feedLoader" hidden>
                <span class="feed-spinner" aria-hidden="true"></span>
                Carregando mais produtos...
            </div>

            <div class="feed-error" id="feedErro" hidden>
                <p>Não foi possível carregar os produtos.</p>
                <button type="button" id="feedTentar">Tentar novamente</button>
            </div>

            <div class="feed-end" id="feedFim" hidden>Você chegou ao fim. 🎉</div>

            <div id="feedSentinela"
                 data-tem-mais="@(Model.TemMais ? "true" : "false")"
                 data-url="@Url.Action("Index", "Feed")"></div>
        </section>
    </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const form      = document.getElementById("feedForm");
    const grid      = document.getElementById("feedGrid");
    const sentinela = document.getElementById("feedSentinela");
    const loader    = document.getElementById("feedLoader");
    const erro      = document.getElementById("feedErro");
    const fim       = document.getElementById("feedFim");
    const vazio     = document.getElementById("feedVazio");
    const totalEl   = document.getElementById("feedTotal");
    const totalTxt  = document.getElementById("feedTotalTexto");
    const ordem     = document.getElementById("feedOrdem");
    const filtros   = document.getElementById("feedFilters");
    const btnFiltros = document.getElementById("btnFiltros");

    const URL_FEED = location.pathname;

    let pagina = 1;                                   // última página já carregada
    let temMais = sentinela.dataset.temMais === "true";
    let carregando = false;
    let geracao = 0;                                  // invalida respostas antigas ao trocar filtros
    let controle = null;                              // AbortController da requisição atual

    // ---------- helpers ----------
    function parametros(numeroPagina) {
        const params = new URLSearchParams();
        for (const [chave, valor] of new FormData(form).entries()) {
            if (valor !== "") params.append(chave, valor);
        }
        if (numeroPagina) params.set("pagina", numeroPagina);
        return params;
    }

    function atualizarTotal(total) {
        totalEl.textContent = total.toLocaleString("pt-BR");
        totalTxt.textContent = total === 1 ? "produto" : "produtos";
    }

    function atualizarEstadoFinal() {
        const temCards = grid.children.length > 0;
        vazio.hidden = temCards;
        fim.hidden = temMais || !temCards;
    }

    function sentinelaVisivel() {
        return sentinela.getBoundingClientRect().top < window.innerHeight + 600;
    }

    // ---------- carregamento ----------
    async function carregar(reiniciar) {
        if (reiniciar) {
            geracao++;
            if (controle) controle.abort();
            pagina = 0;
            temMais = true;
            carregando = false;
            grid.innerHTML = "";
            vazio.hidden = true;
            fim.hidden = true;
        }

        if (carregando || !temMais) return;

        carregando = true;
        erro.hidden = true;
        loader.hidden = false;

        const minhaGeracao = geracao;
        controle = new AbortController();

        try {
            const resposta = await fetch(URL_FEED + "?" + parametros(pagina + 1), {
                headers: { "X-Requested-With": "XMLHttpRequest" },
                signal: controle.signal
            });

            if (!resposta.ok) throw new Error("HTTP " + resposta.status);

            const html = await resposta.text();
            if (minhaGeracao !== geracao) return;

            grid.insertAdjacentHTML("beforeend", html);
            pagina++;
            temMais = resposta.headers.get("X-Tem-Mais") === "true";

            const total = resposta.headers.get("X-Total");
            if (total !== null) atualizarTotal(parseInt(total, 10));

            atualizarEstadoFinal();
        } catch (e) {
            if (e.name === "AbortError" || minhaGeracao !== geracao) return;
            erro.hidden = false;
        } finally {
            if (minhaGeracao === geracao) {
                carregando = false;
                loader.hidden = true;

                // Se a tela for alta e o fim da lista ainda estiver visível, carrega a próxima
                if (temMais && erro.hidden && sentinelaVisivel()) carregar(false);
            }
        }
    }

    // ---------- scroll infinito ----------
    new IntersectionObserver(function (entradas) {
        if (entradas[0].isIntersecting) carregar(false);
    }, { rootMargin: "600px 0px" }).observe(sentinela);

    document.getElementById("feedTentar").addEventListener("click", function () {
        carregar(false);
    });

    // ---------- filtros ----------
    function aplicarFiltros() {
        // mantém a URL compartilhável (sem a página)
        const qs = parametros().toString();
        history.replaceState(null, "", qs ? "?" + qs : location.pathname);

        const topo = document.querySelector(".feed-layout").getBoundingClientRect().top + window.scrollY - 80;
        if (window.scrollY > topo) window.scrollTo({ top: Math.max(topo, 0), behavior: "smooth" });

        carregar(true);
    }

    let temporizador = null;

    form.addEventListener("change", aplicarFiltros);
    ordem.addEventListener("change", aplicarFiltros);

    // preço: aplica enquanto digita (com pequeno atraso)
    form.querySelectorAll('input[type="number"]').forEach(function (campo) {
        campo.addEventListener("input", function () {
            clearTimeout(temporizador);
            temporizador = setTimeout(aplicarFiltros, 500);
        });
    });

    form.addEventListener("submit", function (e) {
        e.preventDefault();
        aplicarFiltros();
        filtros.classList.remove("is-open");
        btnFiltros.setAttribute("aria-expanded", "false");
    });

    document.getElementById("feedLimpar").addEventListener("click", function (e) {
        e.preventDefault();
        form.querySelectorAll('input[type="checkbox"]').forEach(function (c) { c.checked = false; });
        form.querySelectorAll('input[type="number"]').forEach(function (c) { c.value = ""; });
        ordem.value = "recentes";
        aplicarFiltros();
    });

    // ---------- filtros no celular ----------
    btnFiltros.addEventListener("click", function () {
        const aberto = filtros.classList.toggle("is-open");
        btnFiltros.setAttribute("aria-expanded", String(aberto));
    });

    atualizarEstadoFinal();
});
</script>