@using Ecommerce.DTO
@inject Ecommerce.Services.LojaVirtualService LojaVirtualService
@{
    var lojasPopulares = await LojaVirtualService.ObterLojasMaisCompradasAsync(3);
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce</title>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/busca.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="main-header">
        <div class="header-content">
            <a href="/" class="logo">
                nexo<span>.</span>
            </a>
            <form class="search-container" id="searchForm" method="get"
                  asp-controller="Feed" asp-action="Index"
                  data-url-sugestoes="@Url.Action("Sugestoes", "Produto")"
                  data-url-detalhes="@Url.Action("Detalhes", "Produto")">
                <div class="search-icon">
                    <span class="material-symbols-outlined">search</span>
                </div>
                <input type="text" id="searchInput" name="Busca" autocomplete="off"
                       value="@Context.Request.Query["Busca"]"
                       placeholder="O que você está procurando?"
                       role="combobox" aria-expanded="false" aria-controls="searchSugestoes" />
                <ul class="search-suggestions" id="searchSugestoes" role="listbox" hidden></ul>
            </form>
            <div class="user-area">
                <div class="user-icon">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="user-text">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span id="txtLogado">Olá, @User.Identity.Name.Split(' ')[0]</span>
                        <a asp-controller="Usuario" asp-action="Conta">Minha Conta</a>
                    }
                    else
                    {
                        <span class="welcome">Bem-vindo(a)</span>
                        <a asp-controller="Usuario" asp-action="Login">Entre ou cadastre-se</a>
                    }
                </div>
            </div>
            <button type="button" class="cart" data-carrinho-acao="Sidebar">
                <span class="material-symbols-outlined">shopping_cart</span>
                <span>Carrinho</span>
            </button>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="nexo-footer">
        <div class="footer-newsletter">
            <div class="newsletter-content">
                <span class="footer-eyebrow">FIQUE POR DENTRO</span>
                <h2>
                    O que vem por aí, direto<br>
                    na sua caixa de entrada.
                </h2>
                <p>
                    Novidades, inspirações e boas descobertas. Sem excesso.
                </p>
            </div>

            <form class="newsletter-form">
                <label for="newsletter-email">Seu melhor e-mail</label>
                <div class="newsletter-input">
                    <input type="email"
                           id="newsletter-email"
                           placeholder="voce@exemplo.com"
                           required>
                    <button type="submit" aria-label="Inscrever-se">
                        <span class="material-symbols-outlined">
                            arrow_forward
                        </span>
                    </button>
                </div>
            </form>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-main">
            <div class="footer-brand">
                <a href="/" class="logoBranca">
                    nexo<span>.</span>
                </a>
                <p>Conectando você ao que importa.</p>
            </div>
            <div class="footer-column">
                <h3>Explore</h3>

                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="FeedProduto" asp-action="Index">Todos os produtos</a>
                <a href="#" class="footer-column">Cupons</a>
            </div>
            <div class="footer-column">
                <h3>Lojas</h3>

                @foreach (var loja in lojasPopulares)
                {
                    <a href="/FeedProduto?Ordem=recentes&Lojas=@loja.CdLojaVirtual" class="footer-column">@loja.NmLojaVirtual</a>
                } 
            </div>
            <div class="footer-column">
                <h3>Sua conta</h3>

                @if(User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Usuario" asp-action="Conta">Minha conta</a>
                    <a asp-controller="Carrinho" asp-action="Index">Meu Carrinho</a>
                    <form asp-controller="Usuario" asp-action="Logout" method="post" style="display: contents;">
                        <button type="submit">
                            Sair
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Usuario" asp-action="Login">Login</a>
                    <a asp-controller="Usuario" asp-action="Cadastro">Cadastrar-se</a>
                    <button data-carrinho-acao="Sidebar">Meu carrinho</button>
                }
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 Nexo. Interface demonstrativa.</span>
            <span>Feito por Cristiano Faria Mota.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <div class="cart-overlay" id="carrinhoOverlay"></div>
    <aside class="cart-drawer" id="carrinhoSidebar" aria-hidden="true">
        <div class="cart-drawer-inner" id="carrinhoConteudo"></div>
    </aside>

    <script src="~/js/carrinho.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
