<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce</title>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="main-header">
        <div class="header-content">
            <a href="/" class="logo">
                nexo<span>.</span>
            </a>
            <div class="search-container">
                <div class="search-icon">
                    <span class="material-symbols-outlined">
                        search
                    </span>
                </div>
                <input type="text"
                       placeholder="O que você está procurando?" />

                <button class="search-button">
                    Buscar
                </button>
            </div>
            <div class="user-area">
                <div class="user-icon">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div class="user-text">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span id="txtLogado">Olá, @User.Identity.Name.Split(' ')[0]</span>
                        <a asp-controller="Usuario" asp-action="Conta">Minha Conta</a>
                    }
                    else
                    {
                        <span class="welcome">Bem-vindo(a)</span>
                        <a asp-controller="Usuario" asp-action="Login">Entre ou cadastre-se</a>
                    }
                </div>
            </div>
            <button class="cart">
                <span class="material-symbols-outlined">
                    shopping_cart
                </span>
                <span>
                    Carrinho
                </span>
            </button>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="nexo-footer">
        <div class="footer-newsletter">
            <div class="newsletter-content">
                <span class="footer-eyebrow">FIQUE POR DENTRO</span>
                <h2>
                    O que vem por aí, direto<br>
                    na sua caixa de entrada.
                </h2>
                <p>
                    Novidades, inspirações e boas descobertas. Sem excesso.
                </p>
            </div>

            <form class="newsletter-form">
                <label for="newsletter-email">Seu melhor e-mail</label>
                <div class="newsletter-input">
                    <input type="email"
                           id="newsletter-email"
                           placeholder="voce@exemplo.com"
                           required>
                    <button type="submit" aria-label="Inscrever-se">
                        <span class="material-symbols-outlined">
                            arrow_forward
                        </span>
                    </button>
                </div>
            </form>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-main">
            <div class="footer-brand">
                <a href="/" class="logoBranca">
                    nexo<span>.</span>
                </a>
                <p>Conectando você ao que importa.</p>
            </div>
            <div class="footer-column">
                <h3>Explore</h3>

                <a href="#">Todos os produtos</a>
                <a href="#">Áudio</a>
                <a href="#">Fotografia</a>
            </div>
            <div class="footer-column">
                <h3>Lojas</h3>

                <a href="#">AudioLab</a>
                <a href="#">Frame Studio</a>
            </div>
            <div class="footer-column">
                <h3>Sua conta</h3>

                <a href="#">Minha conta</a>
                <a href="#">Meu carrinho</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 Nexo. Interface demonstrativa.</span>
            <span>Feito por Cristiano Faria Mota.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
