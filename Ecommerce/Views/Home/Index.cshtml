<partial name="_NavegacaoCategorias" />

<main class="main-content">
    <section class="hero" id="heroCarousel" aria-roledescription="carousel" aria-label="Destaques">

        <div class="hero-track">
            @for (int i = 0; i < slidesHero.Length; i++)
            {
                var s = slidesHero[i];

                <div class="hero-slide @(i == 0 ? "is-active" : "")"
                     aria-hidden="@(i == 0 ? "false" : "true")">

                    <div class="hero-content">
                        <div class="hero-label">
                            <span class="hero-line"></span>
                            <span>@s.Rotulo</span>
                        </div>

                        <h1>
                            @s.Titulo<br />
                            @s.Linha2<strong>@s.Destaque</strong>
                        </h1>

                        <p>
                            @s.Texto
                            <br />
                            @s.Texto2
                        </p>

                        <a href="@s.Link" class="hero-button">
                            <span>@s.Botao</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>

                    <div class="hero-image" style="--hero-bg: @s.Fundo">
                        <img src="~/images/@s.Imagem" alt="@s.Alt" />
                        <div class="image-caption">@s.Legenda</div>
                    </div>
                </div>
            }
        </div>

        <!-- Controles -->
        <div class="hero-pagination">
            <div class="pagination-line">
                <span id="heroProgresso"></span>
            </div>

            <span class="pagination-number">
                <b id="heroAtual">01</b> / @slidesHero.Length.ToString("00")
            </span>

            <div class="hero-nav">
                <button type="button" class="carousel-btn" id="heroPrev" aria-label="Banner anterior">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <button type="button" class="carousel-btn" id="heroNext" aria-label="Próximo banner">
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </div>
        </div>

    </section>

    <section class="benefits">
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    local_shipping
                </span>
            </div>
            <div class="benefit-text">
                <h3> Entrega para todo o Brasil </h3>
                <p> Rápida, segura e do seu jeito </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    verified_user
                </span>
            </div>
            <div class="benefit-text">
                <h3>
                    Compra com confiança
                </h3>
                <p>
                    Uma experiência tranquila
                </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    undo
                </span>
            </div>
            <div class="benefit-text">
                <h3>Troca descomplicada</h3>
                <p>Você em primeiro lugar</p>
            </div>
        </div>
        <div class="benefit last-benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    stars_2
                </span>
            </div>
            <div class="benefit-text">
