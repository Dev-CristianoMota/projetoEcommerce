@using Ecommerce.DTO
@using Ecommerce.Services
@{
    ViewData["Title"] = "Ecommerce";

    var categorias = ViewBag.CategoriasMaisVendidas as List<DTOCategoriaMaisVendida> ?? new List<DTOCategoriaMaisVendida>();

    var produtosVendidos = ViewBag.ProdutosMaisVendidos as List<List<DTOProdutoMaisVendido>> ?? new List<List<DTOProdutoMaisVendido>>();

    var produtosRecentes = ViewBag.ProdutosMaisRecentes as List<List<DTOProdutoMaisRecentes>> ?? new List<List<DTOProdutoMaisRecentes>>();

    var pt = new System.Globalization.CultureInfo("pt-BR");

    var slidesHero = new[]
    {
        new {
                Rotulo   = "A ESCOLHA É SUA. O EXTRA É NOSSO.",
                Titulo   = "O próximo nível",
                Linha2   = "começa ",
                Destaque = "aqui.",
                Texto    = "Descubra produtos que combinam com o seu jeito de viver.",
                Texto2   = "Tecnologia, design e novas possibilidades em um só lugar.",
                Botao    = "Explorar coleção",
                Link     = "/FeedProduto?Ordem=recentes&Categorias=17&Categorias=3&Categorias=2&Categorias=1&Categorias=21",
                Imagem   = "banner_inicial_1.png",
                Alt      = "Fone de ouvido Bluetooth",
                Legenda  = "SOM QUE TE LEVA ALÉM — STUDIO PRO",
                Fundo    = "linear-gradient(135deg, #EAF2FF 0%, #D5E1F5 20%, #A9BCDE 40%, #7189B1 60%, #344B70 80%, #071426 100%)"
        },
        new {
                Rotulo   = "ELETRODOMÉSTICOS",
                Titulo   = "Sua casa",
                Linha2   = "em outro ",
                Destaque = "nível.",
                Texto    = "Mais praticidade, conforto e eficiência para o seu dia a dia.",
                Texto2   = "Descubra eletrodomésticos que transformam sua rotina.",
                Botao    = "Explorar produtos",
                Link     = "/FeedProduto?Ordem=recentes&Categorias=6",
                Imagem   = "banner_inicial_2.png",
                Alt      = "Eletrodomésticos modernos para a casa",
                Legenda  = "TECNOLOGIA E PRATICIDADE PARA SUA CASA",
                Fundo    = "linear-gradient(135deg, #EAF2FF 0%, #D5E1F5 20%, #A9BCDE 40%, #7189B1 60%, #344B70 80%, #071426 100%)"
        },
        new {
                Rotulo   = "CUPONS E OFERTAS ESPECIAIS!",
                Titulo   = "Comprar bem",
                Linha2   = "é economizar ",
                Destaque = "mais.",
                Texto    = "Aproveite cupons especiais e economize nas suas compras.",
                Texto2   = "Mais vantagens para você aproveitar o que realmente importa.",
                Botao    = "Explorar cupons",
                Link     = "#",
                Imagem   = "banner_inicial_3.png",
                Alt      = "Cupom promocional de desconto",
                Legenda  = "MAIS VANTAGENS EM CADA COMPRA",
                Fundo    = "linear-gradient(135deg, #EAF2FF 0%, #D5E1F5 20%, #A9BCDE 40%, #7189B1 60%, #344B70 80%, #071426 100%)"
            }
    };
}


<partial name="_NavegacaoCategorias" />

<main class="main-content">
    <section class="hero" id="heroCarousel" aria-roledescription="carousel" aria-label="Destaques">

        <div class="hero-track">
            @for (int i = 0; i < slidesHero.Length; i++)
            {
                var s = slidesHero[i];

                <div class="hero-slide @(i == 0 ? "is-active" : "")"
                     aria-hidden="@(i == 0 ? "false" : "true")">

                    <div class="hero-content">
                        <div class="hero-label">
                            <span class="hero-line"></span>
                            <span>@s.Rotulo</span>
                        </div>

                        <h1>
                            @s.Titulo<br />
                            @s.Linha2<strong>@s.Destaque</strong>
                        </h1>

                        <p>
                            @s.Texto
                            <br />
                            @s.Texto2
                        </p>

                        <a href="@s.Link" class="hero-button">
                            <span>@s.Botao</span>
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>

                    <div class="hero-image" style="--hero-bg: @s.Fundo">
                        <img src="~/images/@s.Imagem" alt="@s.Alt" />
                        <div class="image-caption">@s.Legenda</div>
                    </div>
                </div>
            }
        </div>

        <!-- Controles -->
        <div class="hero-pagination">
            <div class="pagination-line">
                <span id="heroProgresso"></span>
            </div>

            <span class="pagination-number">
                <b id="heroAtual">01</b> / @slidesHero.Length.ToString("00")
            </span>

            <div class="hero-nav">
                <button type="button" class="carousel-btn" id="heroPrev" aria-label="Banner anterior">
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <button type="button" class="carousel-btn" id="heroNext" aria-label="Próximo banner">
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </div>
        </div>

    </section>

    <section class="benefits">
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    local_shipping
                </span>
            </div>
            <div class="benefit-text">
                <h3> Entrega para todo o Brasil </h3>
                <p> Rápida, segura e do seu jeito </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    verified_user
                </span>
            </div>
            <div class="benefit-text">
                <h3>
                    Compra com confiança
                </h3>
                <p>
                    Uma experiência tranquila
                </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    undo
                </span>
            </div>
            <div class="benefit-text">
                <h3>Troca descomplicada</h3>
                <p>Você em primeiro lugar</p>
            </div>
        </div>
        <div class="benefit last-benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    stars_2
                </span>
            </div>
            <div class="benefit-text">
                <h3>Achados especiais</h3>
                <p>Escolhas que valem a pena</p>
            </div>
        </div>
    </section>

    @* =====================================================
       MAIS VENDIDOS — carrossel de 5 em 5 (15 produtos)
       ===================================================== *@
    @if (produtosVendidos.Count > 0)
    {
        <section class="products-section">
            <div class="products-container">

                <!-- Cabeçalho -->
                <div class="section-header">
                    <div>
                        <span class="eyebrow">FEITO PARA VOCÊ</span>
                        <h2>Os mais vendidos do momento.</h2>
                        <p>Uma seleção que todo mundo está de olho.</p>
                    </div>

                    <div class="carousel-controls">
                        <span class="carousel-indicator" id="carouselIndicador">1 / @produtosVendidos.Count</span>

                        <button type="button" class="carousel-btn" id="btnPrev" aria-label="Produtos anteriores">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>
                        <button type="button" class="carousel-btn" id="btnNext" aria-label="Próximos produtos">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- Carrossel -->
                <div class="products-carousel" id="produtosCarousel">
                    <div class="carousel-track">

                        @for (int p = 0; p < produtosVendidos.Count; p++)
                        {
                            <div class="carousel-page">

                                @for (int i = 0; i < produtosVendidos[p].Count; i++)
                                {
                                    var produto = produtosVendidos[p][i];

                                    <article class="product-card">

                                        <div class="product-image">

                                            @if (p == 0 && i == 0)
                                            {
                                                <span class="badge">Mais vendido</span>
                                            }

                                            <button class="favorite" aria-label="Adicionar aos favoritos">
                                                <span class="material-symbols-outlined">favorite</span>
                                            </button>

                                            <button class="add-button" aria-label="Adicionar ao carrinho">
                                                <span class="material-symbols-outlined">add</span>
                                            </button>

                                            <img src="@(produto.NmUrlImagem.Miniatura(400, 400) ?? Url.Content("~/images/sem-imagem.png"))"
                                                     alt="@produto.NmProduto"
                                                     loading="lazy">
                                        </div>

                                        <div class="product-info">
                                            <span class="product-category">@produto.NmLojaVirtual.ToUpper()</span>

                                            <h3>@produto.NmProduto</h3>

                                            <div class="price">
                                                <strong>@produto.VlProduto.ToString("C", pt)</strong>
                                            </div>

                                            <p class="installment">
                                                ou 10x de @((produto.VlProduto / 10).ToString("C", pt)) sem juros
                                            </p>
                                        </div>

                                    </article>
                                }

                            </div>
                        }

                    </div>
                </div>

            </div>
        </section>
    }

    <section class="highlight highlight-smartphones">
        <div class="highlight-content">
            <span class="highlight-label">TELEFONIA</span>

            <h1>
                Tudo na palma<br>
                da sua mão.
            </h1>

            <p>
                Telas maiores, câmeras que não perdoam e bateria para o dia
                inteiro. Os smartphones mais desejados, em até 10x sem juros.
            </p>

            <a href="/FeedProduto?Ordem=recentes&Categorias=3" class="highlight-button">
                <span>Acessar smartphones</span>
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="highlight-stage">
            <div class="phone-glow"></div>

            <img class="phone-img" src="~/images/banner_secundario_1.png" alt="Smartphone" />

            <span class="stage-chip chip-1">128 GB</span>
            <span class="stage-chip chip-2">Câmera tripla</span>
            <span class="stage-chip chip-3">6,5″ · 8 GB RAM</span>
        </div>
    </section>

    @if (produtosRecentes.Count > 0)
    {
        <section class="products-section">
            <div class="products-container">

                <!-- Cabeçalho -->
                <div class="section-header">
                    <div>
                        <span class="eyebrow">ACABARAM DE CHEGAR</span>
                        <h2>Produtos mais recentes.</h2>
                        <p>Confira as novidades que chegaram à nossa loja.</p>
                    </div>

                    <div class="carousel-controls">
                        <span class="carousel-indicator" id="recentesIndicador">
                            1 / @produtosRecentes.Count
                        </span>

                        <button type="button"
                                class="carousel-btn"
                                id="recentesPrev"
                                aria-label="Produtos recentes anteriores">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>

                        <button type="button"
                                class="carousel-btn"
                                id="recentesNext"
                                aria-label="Próximos produtos recentes">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- Carrossel dos produtos recentes -->
                <div class="products-carousel" id="produtosRecentesCarousel">
                    <div class="carousel-track">

                        @for (int p = 0; p < produtosRecentes.Count; p++)
                        {
                            <div class="carousel-page">

                                @for (int i = 0; i < produtosRecentes[p].Count; i++)
                                {
                                    var produto = produtosRecentes[p][i];

                                    <article class="product-card">
                                        <div class="product-image">

                                            @if (p == 0 && i == 0)
                                            {
                                                <span class="badge">Novidade</span>
                                            }

                                            <button type="button"
                                                    class="favorite"
                                                    aria-label="Adicionar aos favoritos">
                                                <span class="material-symbols-outlined">favorite</span>
                                            </button>

                                            <button class="add-button" aria-label="Adicionar ao carrinho">
                                                <span class="material-symbols-outlined">add</span>
                                            </button>

                                            <img src="@(produto.NmUrlImagem.Miniatura(400, 400) ?? Url.Content("~/images/sem-imagem.png"))" 
                                                    alt="@produto.NmProduto"
                                                    loading="lazy">
                                        </div>

                                        <div class="product-info">
                                            <span class="product-category">
                                                @produto.NmLojaVirtual.ToUpper()
                                            </span>

                                            <h3>@produto.NmProduto</h3>

                                            <div class="price">
                                                <strong>
                                                    @produto.VlProduto.ToString("C", pt)
                                                </strong>
                                            </div>

                                            <p class="installment">
                                                ou 10x de
                                                @((produto.VlProduto / 10).ToString("C", pt))
                                                sem juros
                                            </p>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
        </section>
    }

    <section class="community">

        <div class="community-content">

            <span class="community-label">
                NOSSA COMUNIDADE
            </span>

            <h2>
                Boas descobertas<br>
                começam por aqui.
            </h2>

            <p>
                Conheça as lojas que fazem parte do nosso universo e
                encontre o que você procura.
            </p>

            <a href="#" class="community-button">
                <span>Conhecer Lojas</span>

                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

        </div>


        <div class="community-stores">

            <a href="#" class="community-card community-card-blue">

                <span class="material-symbols-outlined community-card-icon">
                    store
                </span>

                <div class="community-card-info">
                    <h3>AudioLab</h3>

                    <span>
                        Som para sentir mais
                    </span>
                </div>

            </a>


            <a href="#" class="community-card community-card-dark">

                <span class="material-symbols-outlined community-card-icon">
                    store
                </span>

                <div class="community-card-info">
                    <h3>Frame Studio</h3>

                    <span>
                        Novos olhares sempre
                    </span>
                </div>

            </a>

        </div>

    </section>

    <section class="categories">
        <div class="section-header">
            <div>
                <span class="eyebrow">FEITO PARA VOCÊ</span>
                <h2>Principais Categorias</h2>
                <p>Uma seleção que todo mundo está de olho.</p>
            </div>

            <a href="/FeedProduto" class="view-all">
                Ver todas as Categorias
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="categories-grid">
            @foreach (var c in categorias)
            {
                <a href="/FeedProduto?Ordem=recentes&Categorias=@c.CdCategoria" class="category-card">
                    <div class="category-image">
                        <img src="/images/categorias/@(c.CdCategoria).webp" alt="@c.NmCategoria">
                    </div>
                    <div class="category-name">@c.NmCategoria</div>
                </a>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}
