@using Ecommerce.DTO
@{
    ViewData["Title"] = "Ecommerce";

    var categorias = ViewBag.CategoriasMaisVendidas as List<DTOCategoriaMaisVendida> ?? new List<DTOCategoriaMaisVendida>();

    var produtosVendidos = ViewBag.ProdutosMaisVendidos as List<List<DTOProdutoMaisVendido>> ?? new List<List<DTOProdutoMaisVendido>>();

    var produtosRecentes = ViewBag.ProdutosMaisRecentes as List<List<DTOProdutoMaisRecentes>> ?? new List<List<DTOProdutoMaisRecentes>>();

    var pt = new System.Globalization.CultureInfo("pt-BR");
}


<partial name="_NavegacaoCategorias" />

<main class="main-content">
    <section class="hero">
        <div class="hero-content">
            <div class="hero-label">
                <span class="hero-line"></span>
                <span>A ESCOLHA É SUA. O EXTRA É NOSSO.</span>
            </div>
            <h1>O próximo nível<br />
                começa <strong>aqui.</strong>
            </h1>
            <p>
                Descubra produtos que combinam com o seu jeito de viver.
                <br />
                Tecnologia, design e novas possibilidades em um só lugar.
            </p>
            <a href="#" class="hero-button">
                <span>
                    Explorar coleção
                </span>
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
            <div class="hero-pagination">
                <div class="pagination-line">
                    <span></span>
                </div>
                <span class="pagination-number">
                    01 / 03
                </span>
            </div>
        </div>

        <div class="hero-image">
            <img src="~/images/banner-headphone.jpg"
                 alt="Fone de ouvido" />
            <div class="image-caption">
                SOM QUE TE LEVA ALÉM — STUDIO PRO
            </div>
        </div>
    </section>

    <section class="benefits">
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    local_shipping
                </span>
            </div>
            <div class="benefit-text">
                <h3> Entrega para todo o Brasil </h3>
                <p> Rápida, segura e do seu jeito </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    verified_user
                </span>
            </div>
            <div class="benefit-text">
                <h3>
                    Compra com confiança
                </h3>
                <p>
                    Uma experiência tranquila
                </p>
            </div>
        </div>
        <div class="benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    undo
                </span>
            </div>
            <div class="benefit-text">
                <h3>Troca descomplicada</h3>
                <p>Você em primeiro lugar</p>
            </div>
        </div>
        <div class="benefit last-benefit">
            <div class="benefit-icon">
                <span class="material-symbols-outlined">
                    stars_2
                </span>
            </div>
            <div class="benefit-text">
                <h3>Achados especiais</h3>
                <p>Escolhas que valem a pena</p>
            </div>
        </div>
    </section>

    @* =====================================================
       MAIS VENDIDOS — carrossel de 5 em 5 (15 produtos)
       ===================================================== *@
    @if (produtosVendidos.Count > 0)
    {
        <section class="products-section">
            <div class="products-container">

                <!-- Cabeçalho -->
                <div class="section-header">
                    <div>
                        <span class="eyebrow">FEITO PARA VOCÊ</span>
                        <h2>Os mais vendidos do momento.</h2>
                        <p>Uma seleção que todo mundo está de olho.</p>
                    </div>

                    <div class="carousel-controls">
                        <span class="carousel-indicator" id="carouselIndicador">1 / @produtosVendidos.Count</span>

                        <button type="button" class="carousel-btn" id="btnPrev" aria-label="Produtos anteriores">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>
                        <button type="button" class="carousel-btn" id="btnNext" aria-label="Próximos produtos">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- Carrossel -->
                <div class="products-carousel" id="produtosCarousel">
                    <div class="carousel-track">

                        @for (int p = 0; p < produtosVendidos.Count; p++)
                        {
                            <div class="carousel-page">

                                @for (int i = 0; i < produtosVendidos[p].Count; i++)
                                {
                                    var produto = produtosVendidos[p][i];

                                    <article class="product-card">

                                        <div class="product-image">

                                            @if (p == 0 && i == 0)
                                            {
                                                <span class="badge">Mais vendido</span>
                                            }

                                            <button class="favorite" aria-label="Adicionar aos favoritos">
                                                ♡
                                            </button>

                                            <button class="add-button" aria-label="Adicionar ao carrinho">
                                                +
                                            </button>

                                            <img src="/images/produtos/@(produto.CdProduto).webp"
                                                 alt="@produto.NmProduto"
                                                 onerror="this.style.display='none'">
                                        </div>

                                        <div class="product-info">
                                            <span class="product-category">@produto.NmLojaVirtual.ToUpper()</span>

                                            <h3>@produto.NmProduto</h3>

                                            <div class="price">
                                                <strong>@produto.VlProduto.ToString("C", pt)</strong>
                                            </div>

                                            <p class="installment">
                                                ou 10x de @((produto.VlProduto / 10).ToString("C", pt)) sem juros
                                            </p>
                                        </div>

                                    </article>
                                }

                            </div>
                        }

                    </div>
                </div>

            </div>
        </section>
    }

    <section class="highlight highlight-fotografia">
        <div class="highlight-content">
            <span class="highlight-label">NOVA PERSPECTIVA</span>

            <h1>
                Encontre inspiração<br>
                em cada detalhe.
            </h1>

            <p>
                Equipamentos feitos para capturar ideias, momentos e tudo
                o que ainda está por vir.
            </p>

            <a href="#" class="highlight-button">
                <span>Explorar fotografia</span>
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>
        <div class="highlight-image">

        </div>
    </section>

    @if (produtosRecentes.Count > 0)
    {
        <section class="products-section">
            <div class="products-container">

                <!-- Cabeçalho -->
                <div class="section-header">
                    <div>
                        <span class="eyebrow">ACABARAM DE CHEGAR</span>
                        <h2>Produtos mais recentes.</h2>
                        <p>Confira as novidades que chegaram à nossa loja.</p>
                    </div>

                    <div class="carousel-controls">
                        <span class="carousel-indicator" id="recentesIndicador">
                            1 / @produtosRecentes.Count
                        </span>

                        <button type="button"
                                class="carousel-btn"
                                id="recentesPrev"
                                aria-label="Produtos recentes anteriores">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>

                        <button type="button"
                                class="carousel-btn"
                                id="recentesNext"
                                aria-label="Próximos produtos recentes">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </button>
                    </div>
                </div>

                <!-- Carrossel dos produtos recentes -->
                <div class="products-carousel" id="produtosRecentesCarousel">
                    <div class="carousel-track">

                        @for (int p = 0; p < produtosRecentes.Count; p++)
                        {
                            <div class="carousel-page">

                                @for (int i = 0; i < produtosRecentes[p].Count; i++)
                                {
                                    var produto = produtosRecentes[p][i];

                                    <article class="product-card">
                                        <div class="product-image">

                                            @if (p == 0 && i == 0)
                                            {
                                                <span class="badge">Novidade</span>
                                            }

                                            <button type="button"
                                                    class="favorite"
                                                    aria-label="Adicionar aos favoritos">
                                                ♡
                                            </button>

                                            <button type="button"
                                                    class="add-button"
                                                    aria-label="Adicionar ao carrinho">
                                                +
                                            </button>

                                            <img src="/images/produtos/@(produto.CdProduto).webp"
                                                 alt="@produto.NmProduto"
                                                 onerror="this.style.display='none'">
                                        </div>

                                        <div class="product-info">
                                            <span class="product-category">
                                                @produto.NmLojaVirtual.ToUpper()
                                            </span>

                                            <h3>@produto.NmProduto</h3>

                                            <div class="price">
                                                <strong>
                                                    @produto.VlProduto.ToString("C", pt)
                                                </strong>
                                            </div>

                                            <p class="installment">
                                                ou 10x de
                                                @((produto.VlProduto / 10).ToString("C", pt))
                                                sem juros
                                            </p>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
        </section>
    }

    <section class="community">

        <div class="community-content">

            <span class="community-label">
                NOSSA COMUNIDADE
            </span>

            <h2>
                Boas descobertas<br>
                começam por aqui.
            </h2>

            <p>
                Conheça as lojas que fazem parte do nosso universo e
                encontre o que você procura.
            </p>

            <a href="#" class="community-button">
                <span>Conhecer Lojas</span>

                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>

        </div>


        <div class="community-stores">

            <a href="#" class="community-card community-card-blue">

                <span class="material-symbols-outlined community-card-icon">
                    store
                </span>

                <div class="community-card-info">
                    <h3>AudioLab</h3>

                    <span>
                        Som para sentir mais
                    </span>
                </div>

            </a>


            <a href="#" class="community-card community-card-dark">

                <span class="material-symbols-outlined community-card-icon">
                    store
                </span>

                <div class="community-card-info">
                    <h3>Frame Studio</h3>

                    <span>
                        Novos olhares sempre
                    </span>
                </div>

            </a>

        </div>

    </section>

    <section class="categories">
        <div class="section-header">
            <div>
                <span class="eyebrow">FEITO PARA VOCÊ</span>
                <h2>Principais Categorias</h2>
                <p>Uma seleção que todo mundo está de olho.</p>
            </div>

            <a href="#" class="view-all">
                Ver todas as Categorias
                <span class="material-symbols-outlined">
                    arrow_forward
                </span>
            </a>
        </div>

        <div class="categories-grid">
            @foreach (var c in categorias)
            {
                <a href="#" class="category-card">
                    <div class="category-image">
                        <img src="/images/categorias/@(c.CdCategoria).webp" alt="@c.NmCategoria">
                    </div>
                    <div class="category-name">@c.NmCategoria</div>
                </a>
            }
        </div>
    </section>
</main>

<script>
        document.addEventListener("DOMContentLoaded", function () {

        function inicializarCarrossel(
            carouselId,
            prevId,
            nextId,
            indicadorId
        ) {
            const carousel = document.getElementById(carouselId);

            if (!carousel) return;

            const track = carousel.querySelector(".carousel-track");
            const paginas = carousel.querySelectorAll(".carousel-page");
            const btnPrev = document.getElementById(prevId);
            const btnNext = document.getElementById(nextId);
            const indicador = document.getElementById(indicadorId);

            if (!track || paginas.length === 0 || !btnPrev ||
                !btnNext || !indicador) {
                return;
            }

            let atual = 0;
            const total = paginas.length;

            function atualizar() {
                track.style.transform =
                    `translateX(-${atual * 100}%)`;

                btnPrev.disabled = atual === 0;
                btnNext.disabled = atual === total - 1;

                indicador.textContent = `${atual + 1} / ${total}`;
            }

            btnPrev.addEventListener("click", function () {
                if (atual > 0) {
                    atual--;
                    atualizar();
                }
            });

            btnNext.addEventListener("click", function () {
                if (atual < total - 1) {
                    atual++;
                    atualizar();
                }
            });

            atualizar();
        }

        // Carrossel dos produtos mais vendidos
        inicializarCarrossel(
            "produtosCarousel",
            "btnPrev",
            "btnNext",
            "carouselIndicador"
        );

        // Carrossel dos produtos mais recentes
        inicializarCarrossel(
            "produtosRecentesCarousel",
            "recentesPrev",
            "recentesNext",
            "recentesIndicador"
        );

    });
</script>
